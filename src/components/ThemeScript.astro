---
/**
 * Set data-theme before first paint. Light unless the reader chose
 * otherwise: localStorage "eucalypt-theme" holds "light", "dark" or "auto"
 * (follow the system), set by ThemeSelect.astro. Used on every page, and in
 * place of Starlight's ThemeProvider, so the site has one default (light)
 * and one remembered choice.
 */
---

<script is:inline>
  (() => {
    let choice = null;
    try {
      choice = localStorage.getItem("eucalypt-theme");
    } catch {}
    const system = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
    document.documentElement.dataset.theme = choice === "dark" ? "dark" : choice === "auto" ? system : "light";
  })();
</script>
