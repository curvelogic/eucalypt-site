---
/**
 * The homepage hero's editor, pre-rendered: every example's output in YAML,
 * JSON and TOML (or its diagnostic) is produced by the engine at build time
 * and shipped as HTML, so it shows on first paint with no engine loaded.
 * A small script switches example and format.
 *
 * src/site/hero.ts switches example and format and, on idle or the first
 * edit, mounts the playground's editor and engine over the pre-rendered
 * source and re-evaluates as it changes (docs/site-plan.md, "Hero
 * editor"). Until a source is edited, its pre-rendered output stays.
 */
import { Code } from "astro:components";
import grammar from "../generated/eucalypt.tmLanguage.json";
import { HERO } from "../site/examples";
import { diagnostic, output, playLink, type Format } from "../site/engine";

const FORMATS: { id: Format; label: string; cmd: string }[] = [
  { id: "yaml", label: "YAML", cmd: "eu" },
  { id: "json", label: "JSON", cmd: "eu -j" },
  { id: "toml", label: "TOML", cmd: "eu -x toml" },
];

const examples = await Promise.all(
  HERO.map(async (ex) => ({
    ...ex,
    link: await playLink(ex.source),
    error: ex.fails ? await diagnostic(ex.label, ex.file, ex.source) : null,
    outputs: ex.fails
      ? null
      : Object.fromEntries(await Promise.all(FORMATS.map(async (f) => [f.id, await output(ex.label, ex.source, f.id)]))),
  })),
);
const themes = { light: "github-light", dark: "github-dark" } as const;
const first = examples[0];
---

<div class="gg-hero-ed" data-example={first.id} data-format="yaml">
  <div class="ed-top" role="tablist" aria-label="Examples">
    {
      examples.map((ex, i) => (
        <button
          type="button"
          role="tab"
          class="pick"
          data-pick={ex.id}
          aria-selected={i === 0 ? "true" : "false"}
          aria-controls={`ex-${ex.id}`}
        >
          {ex.fails && <span class="dot" aria-hidden="true" />}
          {ex.label}
        </button>
      ))
    }
  </div>
  <div class="ed-body">
    {
      examples.map((ex, i) => (
        <div
          class="ed-pair"
          id={`ex-${ex.id}`}
          role="tabpanel"
          data-for={ex.id}
          data-source={ex.source}
          data-file={ex.file}
          data-fails={ex.fails ? "" : undefined}
          hidden={i !== 0}
        >
          <div class="ed-src">
            <div class="pane-h">
              <span class="fn">{ex.file}</span>
            </div>
            <div class="ed-edit" data-src tabindex="0" aria-label={`${ex.file}, editable`}>
              <Code code={ex.source} lang={grammar as any} themes={themes} defaultColor={false} class="ed-code" />
            </div>
          </div>
          <div class="ed-out">
            <div class="pane-h">
              <span data-label>{ex.fails ? "Error" : "Output"}</span>
              <div class="fmts" role="group" aria-label="Output format">
                {FORMATS.map((f) => (
                  <button
                    type="button"
                    class="fmt"
                    data-fmt={f.id}
                    data-command={f.cmd}
                    disabled={ex.fails}
                    aria-pressed={f.id === "yaml" ? "true" : "false"}
                  >
                    {f.label}
                  </button>
                ))}
              </div>
            </div>
            {ex.error && <pre class="ed-diag" data-static>{ex.error}</pre>}
            {ex.outputs &&
              FORMATS.map((f) => (
                <div data-out={f.id} data-static hidden={f.id !== "yaml"}>
                  <Code code={ex.outputs![f.id]} lang={f.id} themes={themes} defaultColor={false} class="ed-code" />
                </div>
              ))}
            <pre class="ed-live" data-live aria-live="polite" hidden />
          </div>
          <div class="ed-foot">
            <span class="cmd">
              $ <b data-cmd>eu {ex.file}</b>
            </span>
            <span class="sp" />
            <span class="state" data-state />
            <a href={ex.link} data-link>Open in the playground →</a>
          </div>
        </div>
      ))
    }
  </div>
</div>

<script>
  import "../site/hero";
</script>
