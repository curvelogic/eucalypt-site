---
/**
 * The header shared by the homepage, the docs and /play: the wordmark and
 * the same four links everywhere. Only the active link and the tools on the
 * right (the slot) change between surfaces.
 *
 * Below 50rem (Starlight's own breakpoint) the links give way to a menu.
 * With `menu`, as on the homepage and /play, the header has its own menu
 * button: a disclosure (aria-expanded) over SiteMenu.astro, with the tools
 * in the "menu" slot at its foot. The docs leave `menu` off and use
 * Starlight's menu button, which shows the same SiteMenu.
 */
import Mark from "./Mark.astro";
import SiteMenu from "./SiteMenu.astro";
import { SITE_LINKS, type SiteLinkId } from "./site-links";

interface Props {
  active?: SiteLinkId | "";
  menu?: boolean;
}
const { active = "", menu = false } = Astro.props;
---

<div class="gg-header">
  <a class="gg-wordmark" href="/" aria-label="eucalypt home">
    <Mark size={30} />
    <span>eucalypt</span>
  </a>
  <nav class="gg-nav" aria-label="Site">
    {
      SITE_LINKS.map((l) => (
        <a href={l.href} aria-current={l.id === active ? "page" : undefined}>
          {l.label}
        </a>
      ))
    }
  </nav>
  <div class="gg-tools">
    <slot />
    {
      menu && (
        <button type="button" class="gg-menu-btn" data-menu-btn aria-expanded="false" aria-controls="gg-menu" aria-label="Menu">
          <svg class="open" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
          <svg class="close" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18" />
          </svg>
        </button>
      )
    }
  </div>
  {
    menu && (
      <div class="gg-menu" id="gg-menu" data-menu hidden>
        <SiteMenu active={active}>
          <div class="gg-menu-foot">
            <slot name="menu" />
          </div>
        </SiteMenu>
      </div>
    )
  }
</div>

<script>
  import "../site/menu";
</script>

<style>
  .gg-header {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    height: 100%;
    min-width: 0;
  }
  .gg-wordmark {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--gg-ink);
    text-decoration: none;
    flex: none;
  }
  .gg-wordmark span {
    font-family: var(--gg-display);
    font-weight: 600;
    font-size: 1.45rem;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .gg-nav {
    display: flex;
    gap: 1.4rem;
    font-size: 0.95rem;
    font-weight: 600;
  }
  .gg-nav a {
    color: var(--gg-muted);
    text-decoration: none;
    padding-block: 0.4rem;
  }
  .gg-nav a:hover {
    color: var(--gg-ink);
  }
  .gg-nav a[aria-current="page"] {
    color: var(--gg-ink);
    box-shadow: inset 0 -2px 0 var(--gg-leaf);
  }
  .gg-tools {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    min-width: 0;
  }
  .gg-menu-btn,
  .gg-menu {
    display: none;
  }
  @media (max-width: 50rem) {
    .gg-nav {
      display: none;
    }
    .gg-header {
      gap: 0.75rem;
    }
    .gg-tools {
      gap: 0.6rem;
    }
    .gg-menu-btn {
      display: grid;
    }
    .gg-menu:not([hidden]) {
      display: block;
    }
    /* The tools that move into the menu on a phone. */
    .gg-tools :global(.gg-wide) {
      display: none;
    }
  }
  /* The menu button: the design's bordered icon button; Starlight's on the
     docs is drawn the same (src/styles/starlight.css). */
  .gg-menu-btn {
    place-items: center;
    flex: none;
    width: 2.4rem;
    height: 2.4rem;
    padding: 0;
    border: 1px solid var(--gg-line);
    border-radius: 8px;
    background: var(--gg-surface);
    color: var(--gg-ink);
    cursor: pointer;
  }
  .gg-menu-btn svg {
    width: 1.2rem;
    height: 1.2rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }
  .gg-menu-btn[aria-expanded="true"] {
    background: var(--gg-leaf-wash);
    border-color: var(--gg-leaf);
  }
  .gg-menu-btn[aria-expanded="true"] .open,
  .gg-menu-btn[aria-expanded="false"] .close {
    display: none;
  }
  /* The panel drops from the header's lower edge, over the page. */
  .gg-menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    max-height: calc(100dvh - var(--gg-header-height));
    overflow-y: auto;
    padding: 0.5rem 1rem 1rem;
    background: var(--gg-bg);
    border-bottom: 1px solid var(--gg-line);
    box-shadow: 0 18px 32px -24px rgb(0 0 0 / 0.45);
  }
  .gg-menu-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.85rem;
  }
</style>
