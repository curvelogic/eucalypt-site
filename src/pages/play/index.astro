---
/**
 * /play: the playground, inside the site's shell, laid out as the Ghost
 * Gum design's /play: Share in the header; a toolbar with the example
 * picker, the input mode, the format tabs and Run; source and output side
 * by side (stacked on a phone); the problems panel; and a status line with
 * the engine. src/main.ts wires it up. No grove here: the editor fills the
 * page.
 */
import Site from "../../layouts/Site.astro";
---

<Site title="Playground · eucalypt" description="Write and run eucalypt in the browser." active="play" grove={false} bodyClass="play">
  <button slot="tools" id="share-btn" class="gg-btn playground-only" type="button" title="Copy a link to this code">Share</button>
  <div id="app">
    <div id="toolbar" class="playground-only">
      <label class="tb-field">
        <span class="sr-only">Example</span>
        <select id="example-select" title="Load an example">
          <option value="">Examples…</option>
        </select>
      </label>
      <label class="tb-field">
        <span class="sr-only">Input</span>
        <select id="mode-select" title="Input: a unit of declarations, or one expression (like eu -e)">
          <option value="unit">Unit</option>
          <option value="expr">Expr</option>
        </select>
      </label>
      <span class="tb-space"></span>
      <div id="format-tabs" class="fmts" role="radiogroup" aria-label="Output format">
        {
          ["yaml", "json", "toml", "text", "edn", "html"].map((f) => (
            <button type="button" class="fmt" role="radio" data-fmt={f} aria-checked={f === "yaml" ? "true" : "false"}>
              {f.toUpperCase()}
            </button>
          ))
        }
      </div>
      <button id="run-btn" class="run" type="button" title="Run (Ctrl+Enter)">▶ Run <kbd id="run-key">Ctrl ↵</kbd></button>
    </div>

    <div id="view-bar" class="viewer-only">
      <span id="view-title"></span>
      <span id="view-note">Read-only view of a repository file: it is shown, not run.</span>
      <a id="view-source" target="_blank" rel="noopener">View source on GitHub</a>
      <a id="view-playground" href="./">Open the playground</a>
    </div>
    <div id="view-error" class="viewer-only hidden" role="alert"></div>

    <main id="panes">
      <section id="editor-pane" aria-label="Source">
        <div class="tabs"><span class="on">main.eu</span></div>
        <div id="editor-container"></div>
      </section>
      <section id="output-pane" class="playground-only" aria-label="Output">
        <div class="tabs">
          <span class="on" id="output-label">output.yaml</span>
          <span id="status-indicator" role="status"></span>
          <button id="copy-btn" class="tab-btn" type="button" title="Copy the output">Copy</button>
        </div>
        <div id="output"></div>
      </section>
    </main>

    <section id="problems" class="playground-only" aria-label="Problems">
      <div class="problems-h">
        <span class="problems-title">Problems</span>
        <span id="problems-count">No problems</span>
      </div>
      <div id="error-panel" class="hidden" role="alert">
        <div id="error-message"></div>
        <div id="error-notes"></div>
      </div>
    </section>

    <footer id="status-bar">
      <span id="engine-state">Loading engine…</span>
      <a id="engine-version" target="_blank" rel="noopener"></a>
      <span id="status-hint" class="playground-only">Share copies a link with the code in it</span>
    </footer>

    <div id="loading-overlay">
      <div id="loading-content">
        <div id="loading-spinner"></div>
        <div id="loading-text">Loading Eucalypt…</div>
      </div>
    </div>
  </div>
</Site>

<script>
  import "../../main.ts";
</script>
